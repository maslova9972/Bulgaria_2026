{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulgaria-2026-leads",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-10",
  "vars": {
    "AIRTABLE_BASE_ID": "appjaHCUKxthrm3zI",
    "AIRTABLE_TABLE_ID": "tbl9P4xP0rrsimyo8",
    // Origin is scheme + host only: no path, no trailing slash.
    // The browser sends "https://maslova9972.github.io" regardless of the page path.
    "ALLOWED_ORIGINS": ["https://maslova9972.github.io", "http://localhost:5173"],
    "TURNSTILE_HOSTNAMES": ["maslova9972.github.io", "localhost"],
    "TURNSTILE_ACTION": "lead_submit"
  }
}
