{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bulgaria-2026-leads",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-10",
  // Every deployed version would otherwise get its own public *.workers.dev URL
  // running the same code and secrets. This endpoint handles personal data, so no.
  "preview_urls": false,
  "vars": {
    "AIRTABLE_BASE_ID": "appjaHCUKxthrm3zI",
    "AIRTABLE_TABLE_ID": "tbl9P4xP0rrsimyo8",
    // Origin is scheme + host only: no path, no trailing slash.
    // The browser sends the exact scheme + host of the page, without a path or trailing slash.
    "ALLOWED_ORIGINS": [
      "https://www.bulgaria2026.com",
      "https://bulgaria2026.com",
      "https://maslova9972.github.io",
      "http://localhost:5173"
    ],
    "TURNSTILE_HOSTNAMES": [
      "www.bulgaria2026.com",
      "bulgaria2026.com",
      "maslova9972.github.io",
      "localhost"
    ],
    "TURNSTILE_ACTION": "lead_submit"
  }
}
